# ── Supabase ─────────────────────────────────────────────────────────────────
# Скопіюйте з Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — лише для серверного коду (Route Handlers).
# НІКОЛИ не додавайте NEXT_PUBLIC_ до цього ключа.
# Знайдете у Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin access ──────────────────────────────────────────────────────────────
# Ключ перевіряється на сервері (Route Handler), НЕ в браузері.
# Без NEXT_PUBLIC_ — не потрапляє в JS-бандл.
ADMIN_ACCESS_KEY=change-me-strong-key

# ── Site ──────────────────────────────────────────────────────────────────────
# Використовується для metadata canonical URL (Open Graph тощо).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
